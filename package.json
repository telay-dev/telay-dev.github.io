    "lucide-preact": "^1.68.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@types/http-cache-semantics": "^4.2.0",
    "typescript": "^5.7.3",
    "@rsbuild/core": "^2.3.1",
    "@rsbuild/plugin-preact": "^2.1.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "tailwindcss": "^4.0.0"
  }
}
